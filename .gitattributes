# Normalize line endings on checkin; check out with native endings.
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.sh   text eol=lf

# Binary assets — never diff or normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.woff binary
*.woff2 binary

# Lockfiles: collapse in PR diffs, still versioned.
package-lock.json  linguist-generated=true -diff
pnpm-lock.yaml     linguist-generated=true -diff
yarn.lock          linguist-generated=true -diff
poetry.lock        linguist-generated=true -diff
uv.lock            linguist-generated=true -diff
Cargo.lock         linguist-generated=true -diff
go.sum             linguist-generated=true -diff
